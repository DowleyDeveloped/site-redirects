{% extends "_layouts/cp" %}

{% set title = "Redirects" %}
{% set selectedSubnavItem = "redirects" %}

{% block actionButton %}
    <a class="btn submit add icon" href="{{ url('site-redirects/new') }}">New Redirect</a>
{% endblock %}

{% block content %}
    {% if redirects|length %}
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th>Old Path</th>
                    <th>Target URL</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Enabled</th>
                    <th></th>
					<th></th>
                </tr>
            </thead>
            <tbody>
                {% for redirect in redirects %}
                    <tr>
                        <td>{{ redirect.oldPath }}</td>
                        <td>{{ redirect.targetUrl }}</td>
                        <td>{{ redirect.matchType }}</td>
                        <td>{{ redirect.statusCode }}</td>
                        <td>{{ redirect.priority }}</td>
                        <td>{{ redirect.enabled ? 'Yes' : 'No' }}</td>
                        <td>
                            <a href="{{ url('site-redirects/' ~ redirect.id) }}">Edit</a>
                        </td>
						<td>
							<button
								class="btn small delete-btn"
								data-id="{{ redirect.id }}"
								type="button"
							>
								Delete
							</button>
						</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p>No redirects yet.</p>
    {% endif %}
{% endblock %}

{% js %}
document.querySelectorAll('.delete-btn').forEach(button => {
    button.addEventListener('click', async () => {
        if (!confirm('Are you sure you want to delete this redirect?')) {
            return;
        }

        const id = button.dataset.id;

        const response = await fetch('{{ actionUrl("site-redirects/redirects/delete") }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': Craft.csrfTokenValue,
                'Accept': 'application/json'
            },
            body: JSON.stringify({ id })
        });

        const result = await response.json();

        if (result.success) {
            button.closest('tr').remove();
        } else {
            alert('Failed to delete redirect.');
        }
    });
});
{% endjs %}
